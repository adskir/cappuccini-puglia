---
layout: base.njk
---
<section class="page-hero">
  <h1>{{ title }}</h1>
</section>

<section>
  <div class="article">
    {% if image %}{% image image, title %}{% endif %}
    {{ content | safe }}
  </div>
</section>

<section style="background: var(--cream); padding-top: 0;">
  <div class="container-narrow">
    <h2 class="section-title reveal" style="text-align:center;">Le parole di san Francesco sulla vita religiosa</h2>
    <div class="gold-divider reveal" style="margin-left:auto; margin-right:auto;"></div>
    <div class="quote-grid">
      {% for q in quotes %}
      <div class="quote-card reveal">
        <h4>{{ q.topic }}</h4>
        <p>{{ q.quote }}</p>
        <cite>— san Francesco</cite>
      </div>
      {% endfor %}
    </div>
    <p style="text-align:center;">Se vuoi saperne di più, scrivici a <a href="mailto:{{ settings.curia.email }}">{{ settings.curia.email }}</a> oppure vieni a incontrarci in una delle nostre <a href="/conventi/">fraternità</a>.</p>
  </div>
</section>
