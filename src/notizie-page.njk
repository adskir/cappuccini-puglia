---
layout: base.njk
title: "Notizie"
permalink: /notizie/
---
<section class="page-hero">
  <h1>Notizie della Provincia</h1>
</section>
<section>
  <div class="container">
    <div class="news-grid">
      {% for post in collections.notizie %}
      <a href="{{ post.url }}" class="news-card reveal">
        {% if post.data.image %}<div class="news-card-img">{% image post.data.image, post.data.title, "(min-width: 800px) 400px, 100vw" %}</div>{% endif %}
        <div class="news-card-body">
          <span class="news-date">{{ post.data.date | dateBy }}</span>
          <h3>{{ post.data.title }}</h3>
          <p>{{ post.data.excerpt }}</p>
        </div>
      </a>
      {% endfor %}
    </div>
    <div style="margin-top:36px;">
      <a href="/" class="btn-outline">← Home</a>
    </div>
  </div>
</section>
