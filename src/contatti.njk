---
layout: base.njk
title: "Contatti"
permalink: /contatti/
---
<section class="page-hero">
  <h1>Contatti</h1>
  <div class="breadcrumb">Contattaci</div>
</section>

<section>
  <div class="article">
    <h2>{{ settings.curia.name }}</h2>
    <p>Indirizzo: {{ settings.curia.address }}</p>
    <p>Telefono: <a href="tel:{{ settings.curia.phone }}">{{ settings.curia.phone }}</a></p>
    <p>E-mail: <a href="mailto:{{ settings.curia.email }}">{{ settings.curia.email }}</a></p>

    {% for c in collections.conventi %}
    <h3>{{ c.data.title }}</h3>
    <p>
      {% if c.data.address %}{{ c.data.address }}<br>{% endif %}
      {% if c.data.correspondence_address %}Per corrispondenza: {{ c.data.correspondence_address }}<br>{% endif %}
      {% if c.data.phone %}Tel.: <a href="tel:{{ c.data.phone }}">{{ c.data.phone }}</a><br>{% endif %}
      {% if c.data.email %}E-mail: <a href="mailto:{{ c.data.email }}">{{ c.data.email }}</a>{% endif %}
    </p>
    {% endfor %}
  </div>
</section>

<section style="background: var(--cream);">
  <div class="container-narrow">
    <h2 class="section-title reveal">Scrivici</h2>
    <div class="gold-divider reveal"></div>
    <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="reveal">
      <input type="hidden" name="form-name" value="contact">
      <p style="display:none;"><label>Non compilare questo campo: <input name="bot-field"></label></p>
      <div class="field">
        <label>Nome *</label>
        <input type="text" name="name" required>
      </div>
      <div class="field">
        <label>E-mail *</label>
        <input type="email" name="email" required>
      </div>
      <div class="field">
        <label>Messaggio *</label>
        <textarea name="message" required></textarea>
      </div>
      <button type="submit" class="btn">Invia</button>
    </form>
  </div>
</section>

<section style="background: var(--cream); padding-top: 0;">
  <div class="container">
    <span class="section-label reveal">Tutte le nostre fraternità sulla mappa</span>
    <h2 class="section-title reveal">I nostri conventi</h2>
    <div class="gold-divider reveal"></div>
    <div id="map-tutti-conventi" style="height:420px; border-radius:8px; overflow:hidden;"></div>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
      (function () {
        var points = [
          {% for c in collections.conventi %}
          {% if c.data.lat and c.data.lng %}
          { lat: {{ c.data.lat }}, lng: {{ c.data.lng }}, title: "{{ c.data.title }}", url: "{{ c.url }}" }{% if not loop.last %},{% endif %}
          {% endif %}
          {% endfor %}
        ];
        if (points.length === 0) return;
        var m = L.map('map-tutti-conventi');
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '&copy; OpenStreetMap'
        }).addTo(m);
        var bounds = [];
        points.forEach(function (p) {
          L.marker([p.lat, p.lng]).addTo(m).bindPopup('<a href="' + p.url + '">' + p.title + '</a>');
          bounds.push([p.lat, p.lng]);
        });
        m.fitBounds(bounds, { padding: [30, 30] });
      })();
    </script>
  </div>
</section>
