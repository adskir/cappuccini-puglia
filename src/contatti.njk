---
layout: base.njk
title: "Contatti"
permalink: /contatti/
---
<section class="page-hero">
  <h1>Contatti</h1>
  <div class="breadcrumb">Contattaci</div>
</section>

<section>
  <div class="article">
    <h2>{{ settings.curia.name }}</h2>
    <p>Indirizzo: {{ settings.curia.address }}</p>
    <p>Telefono: <a href="tel:{{ settings.curia.phone }}">{{ settings.curia.phone }}</a></p>
    <p>E-mail: <a href="mailto:{{ settings.curia.email }}">{{ settings.curia.email }}</a></p>
  </div>
</section>

<section style="background: var(--cream); padding-top: 0;">
  <div class="container">
    <span class="section-label reveal">Dove siamo</span>
    <h2 class="section-title reveal">La Curia Provinciale</h2>
    <div class="gold-divider reveal"></div>
    <div id="map-curia" style="height:420px; border-radius:8px; overflow:hidden;"></div>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
      (function () {
        {% if settings.curia.lat and settings.curia.lng %}
        var m = L.map('map-curia').setView([{{ settings.curia.lat }}, {{ settings.curia.lng }}], 15);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '&copy; OpenStreetMap'
        }).addTo(m);
        L.marker([{{ settings.curia.lat }}, {{ settings.curia.lng }}]).addTo(m).bindPopup("{{ settings.curia.name }}");
        {% endif %}
      })();
    </script>
  </div>
</section>
