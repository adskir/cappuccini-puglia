---
layout: base.njk
title: "Contatti"
permalink: /contatti/
---
<section class="page-hero">
  <h1>Contatti</h1>
  <div class="breadcrumb">Contattaci</div>
</section>

<section>
  <div class="article">
    <h2>{{ settings.curia.name }}</h2>
    <p>Indirizzo: {{ settings.curia.address }}</p>
    <p>Telefono: <a href="tel:{{ settings.curia.phone }}">{{ settings.curia.phone }}</a></p>
    <p>E-mail: <a href="mailto:{{ settings.curia.email }}">{{ settings.curia.email }}</a></p>
  </div>
</section>

<section style="background: var(--cream); padding-top: 0;">
  <div class="container">
    <span class="section-label reveal">Dove siamo</span>
    <h2 class="section-title reveal">La Curia Provinciale</h2>
    <div class="gold-divider reveal"></div>
    {% if settings.curia.map_embed_url %}
    <div style="border-radius:8px; overflow:hidden;">
      <iframe src="{{ settings.curia.map_embed_url }}" width="100%" height="420" style="border:0;" loading="lazy" allowfullscreen></iframe>
    </div>
    {% else %}
    <div style="height:420px; display:flex; align-items:center; justify-content:center; background:var(--cream); border:1px solid #a0522d22; color:var(--text-mid); font-size:14px; text-align:center; padding:20px; border-radius:8px;">
      La mappa verrà aggiunta (inserire il link embed di Google Maps in settings)
    </div>
    {% endif %}
  </div>
</section>
